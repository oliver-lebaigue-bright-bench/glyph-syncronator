<Window x:Class="GlyphixDesktopCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GLYPHIX // DESKTOP COMPANION" Height="800" Width="640"
        Background="#0B0C0E" Foreground="White"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#14161A"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#272A33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="12,7"/>
        </Style>
        <Style x:Key="InnerBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#1B1D23"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#272A33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Background" Value="#1B1D23"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,12,24,4">
            <DockPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="GLYPHIX" FontSize="24" FontWeight="Bold" FontFamily="Courier New"/>
                        <TextBlock Text=" DESKTOP" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="4,8,0,0"/>
                    </StackPanel>
                    <TextBlock Text="AUDIO REACTIVE GLYPH &amp; ARGB SYNC ENGINE" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                </StackPanel>

                <Border DockPanel.Dock="Right" Background="#14161A" CornerRadius="20" BorderBrush="#272A33" BorderThickness="1" VerticalAlignment="Center" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#64748B" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusPill" Text="STANDBY" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,4">
            <StackPanel>
                <!-- Sync Direction -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="SYNC DIRECTION" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="Choose audio flow between Nothing Phone &amp; PC" FontSize="9" Foreground="#64748B" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="RbPhoneToPc" Content="📥 Phone → PC" IsChecked="True" Style="{StaticResource {x:Type ToggleButton}}" Height="38" Margin="0,0,4,0" Checked="SyncDir_Checked"/>
                            <RadioButton x:Name="RbPcToPhone" Content="📤 PC → Phone" Style="{StaticResource {x:Type ToggleButton}}" Height="38" Margin="4,0,0,0" Checked="SyncDir_Checked"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Audio Spectrum -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="AUDIO SPECTRUM &amp; SOURCE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <ComboBox x:Name="AudioSourceCombo" Margin="0,10,0,10" Background="#1B1D23" Foreground="White" BorderBrush="#272A33" Height="36"/>
                        <Border Background="#08090B" CornerRadius="10" BorderBrush="#272A33" BorderThickness="1" Padding="10">
                            <StackPanel>
                                <Canvas x:Name="SpectrumCanvas" Height="92" Background="Transparent"/>
                                <UniformGrid Columns="6" Margin="0,4,0,0">
                                    <TextBlock Text="SUB-BASS" FontSize="8" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="BASS" FontSize="8" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="LOW-MID" FontSize="8" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="MID" FontSize="8" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="PRESENCE" FontSize="8" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="BRILLIANCE" FontSize="8" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Connectivity -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="WI-FI CONNECTIVITY" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <Border x:Name="PcIpBox" Style="{StaticResource InnerBoxStyle}" Margin="0,10,0,4">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="COPY IP" Width="84" Height="32" Click="CopyIp_Click"/>
                                <StackPanel>
                                    <TextBlock Text="YOUR PC IP (PORT 12347)" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock x:Name="PcIpText" Text="192.168.1.10 : 12347" FontSize="15" FontWeight="Bold" FontFamily="Consolas"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Grid x:Name="PhoneIpBox" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PhoneIpEntry" Margin="0,0,8,0" Height="38" Background="#1B1D23" Foreground="White" BorderBrush="#272A33" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="🔍 DISCOVER" Width="105" Height="38" Click="Discover_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- OpenRGB & DSP -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="HARDWARE SYNC &amp; AUDIO DSP" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12">
                            <CheckBox x:Name="OpenRgbEnable" Content="OpenRGB Sync" VerticalAlignment="Center" Margin="0,0,24,0" Checked="OpenRgb_Toggle" Unchecked="OpenRgb_Toggle"/>
                            <CheckBox x:Name="TypingSuppression" Content="Typing Suppression" IsChecked="True" VerticalAlignment="Center"/>
                        </StackPanel>

                        <DockPanel>
                            <TextBlock Text="AUDIO SENSITIVITY" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="SensText" Text="1.00x" DockPanel.Dock="Right" FontSize="11" FontWeight="Bold" FontFamily="Consolas"/>
                        </DockPanel>
                        <Slider x:Name="SensSlider" Minimum="0.1" Maximum="3.0" Value="1.0" Margin="0,2,0,10"/>

                        <DockPanel>
                            <TextBlock Text="PULSE DECAY / BALLISTICS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="DecayText" Text="82%" DockPanel.Dock="Right" FontSize="11" FontWeight="Bold" FontFamily="Consolas"/>
                        </DockPanel>
                        <Slider x:Name="DecaySlider" Minimum="0.5" Maximum="0.99" Value="0.82" Margin="0,2,0,4"/>
                    </StackPanel>
                </Border>

                <!-- Fan Visualization -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="CASE FAN ARGB VISUALIZATION" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10">
                            <CheckBox x:Name="FanVizEnable" Content="Enable Fan Ring FX" IsChecked="True" Margin="0,0,24,0"/>
                            <CheckBox x:Name="FanClockwise" Content="Clockwise" IsChecked="True"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="CONNECTED ARGB HEADER" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                                    <Button DockPanel.Dock="Right" Content="↻ SCAN" Width="60" Height="20" Click="ScanRgb_Click"/>
                                </DockPanel>
                                <ComboBox x:Name="HeaderCombo" Margin="0,2,0,8" Height="32"/>

                                <TextBlock Text="ANIMATION EFFECT" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                                <ComboBox x:Name="FanModeCombo" Margin="0,2,0,8" Height="32"/>

                                <TextBlock Text="COLOR THEME" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                                <ComboBox x:Name="FanThemeCombo" Margin="0,2,0,8" Height="32"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="🎨 SPECTRUM CHOOSER" Click="ColorPicker_Click"/>
                                    <Border Grid.Column="1" x:Name="ColorSwatch" Width="60" Height="30" Background="White" CornerRadius="8" Margin="6,0,0,0"/>
                                </Grid>

                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="RING LEDS" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <ComboBox x:Name="RingLedCombo" Height="30"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="FAN COUNT" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                                        <ComboBox x:Name="FanCountCombo" Height="30"/>
                                    </StackPanel>
                                </UniformGrid>

                                <DockPanel>
                                    <TextBlock Text="ROTATION / WAVE SPEED" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="SpeedText" Text="1.00x" DockPanel.Dock="Right" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                </DockPanel>
                                <Slider x:Name="SpeedSlider" Minimum="0.2" Maximum="3.0" Value="1.0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#08090B" CornerRadius="12" BorderBrush="#272A33" BorderThickness="1" VerticalAlignment="Top" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="LIVE ARGB PREVIEW" FontSize="9" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <Canvas x:Name="FanCanvas" Width="142" Height="142" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Logs -->
                <Button x:Name="ToggleLogsBtn" Content="▼ SHOW SYSTEM LOGS" Margin="0,4,0,12" Background="Transparent" Foreground="#64748B" BorderThickness="0" Click="ToggleLogs_Click"/>
                <TextBox x:Name="LogBox" Height="120" Margin="12,0,12,16" Background="#08090B" Foreground="#94A3B8" BorderBrush="#272A33" Visibility="Collapsed" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer FAB -->
        <Border Grid.Row="2" Padding="20,4,20,16">
            <Button x:Name="StartBtn" Content="▶ START LISTENER (SYNC PC RGB)" Height="54" Background="White" Foreground="Black" FontWeight="Bold" FontSize="13" Click="Start_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="16"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Border>
    </Grid>
</Window>
